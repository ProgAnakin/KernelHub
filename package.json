{
  "name": "kernelhub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "format:check": "prettier --check app components lib types tests scripts docs README.md next.config.ts playwright.config.ts",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts"
  },
  "dependencies": {
    "framer-motion": "14.6.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.3"
  }
}
